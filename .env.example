# Copy to both .env (Prisma CLI) and server/.env (API). Never commit real credentials.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://tabletomato:tabletomato@localhost:5432/table_tomato?schema=public
# Optional. The API uses in-memory fallbacks when Redis is not configured.
# REDIS_URL=redis://localhost:6379

# Generate distinct random values for every environment (32+ characters each).
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-different-random-secret-of-32-characters
JWT_ISSUER=TableAndTomato
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false
REFRESH_COOKIE_NAME=table_tomato_refresh
CSRF_COOKIE_NAME=table_tomato_csrf
CSRF_SECRET=replace-this-with-another-random-secret-of-at-least-32-characters
# Must decode from base64 to exactly 32 bytes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional Stripe test-mode configuration. Server values stay server-side.
# Set these to your Stripe test-mode values only when developing that integration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Checkout pricing configuration for the existing API service
TAX_RATE_PERCENT=8.875
FREE_SHIPPING_THRESHOLD_CENTS=15000
SHIPPING_FLAT_CENTS=900

# Optional seed account overrides (seed script currently seeds legacy sample products).
ADMIN_INITIAL_EMAIL=admin@table-tomato.local
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-local-password
MANAGER_INITIAL_EMAIL=owner@table-tomato.local
MANAGER_INITIAL_PASSWORD=replace-with-a-strong-local-password
CLIENT_INITIAL_EMAIL=customer@table-tomato.local
CLIENT_INITIAL_PASSWORD=replace-with-a-strong-local-password
